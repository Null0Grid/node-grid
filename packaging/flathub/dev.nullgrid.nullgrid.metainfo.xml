<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.nullgrid.nullgrid</id>
  <name>Null Grid</name>
  <summary>Vertical tab sidebar browser with ad blocking and a login vault</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <!-- Null Grid bundles doomgeneric (GPL-2.0); update this if the app's own
       license changes — see the main repo's README "Why this repo is
       public" section. -->
  <project_license>GPL-2.0-only</project_license>
  <developer id="dev.nullgrid">
    <name>Null Grid</name>
  </developer>
  <url type="homepage">https://search.nullgrid.dev</url>
  <url type="bugtracker">https://github.com/Null0Grid/null-grid/issues</url>

  <description>
    <p>
      Null Grid is a vertical-tab desktop browser with ad and tracker
      blocking, a safeStorage-encrypted login vault, hostname-only history,
      burner tabs, a built-in radio player, and an AI side panel. It's part
      of Null Grid, alongside Null Search and Null Drive.
    </p>
    <p>
      The browser's own main process — never the web page — talks directly
      to a configured Null Drive, so your Drive address and API token never
      reach the search origin.
    </p>
  </description>

  <launchable type="desktop-id">dev.nullgrid.nullgrid.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>Settings → Null Drive, connected</caption>
      <image>https://raw.githubusercontent.com/Null0Grid/null-grid/main/docs/screenshots/null-drive-settings.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1" />

