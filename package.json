{
  "name": "nullgrid-browser",
  "productName": "NODE_GRID",
  "version": "5.1.4",
  "description": "NODE_GRID browser: vertical tab sidebar, favorites, hostname-only history, ad blocking, login vault.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/drive.test.js",
    "test:ui": "node tests/ui-drive.test.js",
    "test:ui:pipdock": "node tests/ui-pipdock.test.js",
    "dist": "electron-packager . NODE_GRID --platform=win32 --arch=x64 --icon=icon.ico --out=dist --overwrite --asar --ignore=\"^/dist\" --ignore=\"^/build\" --ignore=\"^/store-dist\" --ignore=\"INSTALL\\.bat\" --ignore=\"README\\.txt\"",
    "store": "electron-builder --win appx --x64 --publish never",
    "dist:linux": "electron-builder --linux deb rpm AppImage tar.gz --x64 --arm64 --publish never",
    "dist:linux:flatpak": "electron-builder --linux flatpak --x64 --publish never",
    "dist:linux:snap": "electron-builder --linux snap --x64 --publish never",
    "test:ui:masking": "node tests/ui-masking.test.js",
    "test:ui:ytradio": "node tests/ui-ytradio.test.js",
    "test:ui:updates": "node tests/ui-updates.test.js",
    "test:ui:railclose": "node tests/ui-railclose.test.js",
    "test:ui:pinned": "node tests/ui-pinned.test.js",
    "test:ui:favicons": "node tests/ui-favicons.test.js",
    "test:ui:openlinks": "node tests/ui-openlinks.test.js",
    "test:ui:defaultbrowser": "node tests/ui-defaultbrowser.test.js",
    "test:ui:settings": "node tests/ui-settings.test.js",
    "test:ui:core": "node tests/ui-core.test.js",
    "test:ui:fixes": "node tests/ui-fixes.test.js",
    "test:selfupdate": "node tests/selfupdate.test.js",
    "test:ui:downloads": "node tests/ui-downloads.test.js"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/packager": "^18.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "@mozilla/readability": "^0.6.0",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "dev.nullgrid.nodegrid",
    "productName": "NODE_GRID",
    "directories": {
      "output": "store-dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!store-dist/**",
      "!build/**",
      "!*.bat",
      "!README*.txt",
      "!store-identity.txt",
      "!privacy-policy.html",
      "!store-apply.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "appx": {
      "identityName": "FILLED_IN_BY_THE_STORE_KIT",
      "publisher": "CN=FILLED_IN_BY_THE_STORE_KIT",
      "publisherDisplayName": "FILLED_IN_BY_THE_STORE_KIT",
      "applicationId": "NODEGRID",
      "displayName": "NODE_GRID",
      "backgroundColor": "#0a0a0f",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": false,
      "customManifestPath": "appx-manifest.xml",
      "customExtensionsPath": "packaging/appx/browser-extensions.xml",
      "minVersion": "10.0.17763.0"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "flatpak",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "home/icon-512.png",
      "category": "Network;WebBrowser",
      "synopsis": "NODE_GRID: vertical tab sidebar browser with ad blocking and a login vault.",
      "maintainer": "NODE_GRID <support@nullgrid.dev>",
      "executableName": "node-grid",
      "syncDesktopName": true,
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html",
        "application/xhtml+xml"
      ],
      "desktop": {
        "entry": {
          "GenericName": "Web Browser",
          "StartupNotify": "true"
        }
      }
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "rpm": {
      "depends": [
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret"
      ]
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "finishArgs": [
        "--share=ipc",
        "--share=network",
        "--socket=x11",
        "--socket=pulseaudio",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home"
      ]
    },
    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "summary": "NODE_GRID: vertical tab sidebar browser with ad blocking and a login vault.",
      "plugs": [
        "default",
        "home",
        "removable-media",
        "network",
        "network-bind",
        "audio-playback",
        "audio-record",
        "desktop",
        "desktop-legacy",
        "wayland",
        "x11",
        "opengl",
        "browser-support",
        "password-manager-service"
      ]
    }
  },
  "author": "NODE_GRID",
  "homepage": "https://search.nullgrid.dev",
  "desktopName": "node-grid.desktop"
}
